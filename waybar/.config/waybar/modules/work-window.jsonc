{
	"group/work": {
	    	"orientation": "horizontal",
	    	"modules": ["custom/round-left", "hyprland/window#class", "custom/left#c0", "hyprland/window#prog", "custom/left#c1"]
	},

	"hyprland/window#class": {
		"format": "{class}",
		"icon": true,
		"icon-size": 16,
		"rewrite": {
			"": "Desktop",
		},
		"tooltip": false,
	},

	"hyprland/window#prog": {
		"format": "{title}",
		"max-length": 20,
		"rewrite": {
			".* - (?!fish$)(\\S+)": "$1",
			".* - fish": "fish"
		},
		"tooltip": false,
	},

	"custom/left#c0": {
		"format": " ",
		"tooltip": false,
	},
	"custom/left#c1": {
		"format": " ",
		"tooltip": false,
	},
	"custom/round-left": {
		"format": "",
		"tooltip": false,
	}
}
