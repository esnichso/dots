// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height":16, // Waybar height (to be removed for auto height)
    "spacing": 8, // Gaps between modules (4px)
    "margin-top": 4,
    "margin-left": 4,
    "margin-right": 4,

    "reload_style_on_change": true,

    // Choose the order of the modules
    "modules-left": ["hyprland/workspaces", "group/work"],
    "group/work": {
    	"orientation": "horizontal",
    	"modules": ["custom/winstart", "hyprland/window#class", "custom/winsep", "hyprland/window#prog", "custom/winend"]
    },
    "modules-center": ["group/clockmenu"],
    "modules-right": ["tray", "mpris", "group/system"],
    "group/system": {
    	"orientation": "horizontal",
    	"modules": ["custom/notifications","wireplumber", "bluetooth", "network", "battery"]
    },

	"hyprland/workspaces":  {
		"format": "{icon}",
		"persistent-workspaces": { "*": 5},
		"format-icons": {
			"active": "",
			"default": "",
			"urgent": "",
			"empty": ""
		}
	},

	"hyprland/window#class": {
		"format": "{class}",
		"icon": true,
		"icon-size": 16
	},
	"custom/winsep": {
		"format": " ",
		"tooltip": "false"
	},
	"custom/winend": {
		"format": " ",
		"tooltip": "false"
	},
	"custom/winstart": {
		"format": "",
		"tooltip": "false"
	},	

	"hyprland/window#prog": {
		"format": "{title}",
		"max-length": 20,
		"rewrite": {
			".* - (?!fish$)(\\S+)": "$1",
			".* - fish": "fish"
		}
	},

	"network": {
		"format-wifi": "{icon}{essid}", // add signal strenght idicator
		"icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
		"format-ethernet": "󰈀",
		"format-disconnect": "󰤮",
		"tooltip-format": "{ifname}: {ipaddr}",
		"on-click": "pkill -x nmtui || kitty --class tui-popup -e nmtui"
	},

	"group/clockmenu": {
	  "orientation": "horizontal",
	  "drawer": {
	    "click-to-reveal": true,
	    "transition-duration": 300,
	    "children-class": "clock-extra"
	  },
	  "modules": ["clock", "power-profiles-daemon", "idle_inhibitor", "custom/nightlight", "custom/kbd"]
	},
	"power-profiles-daemon": {
		"format": "{icon}",
		"format-icons": {
			"default": "󰓅",
			"power-saver": "󰾆",
			"balanced": "󰾅",		
			"performace": "󰓅"
		},
		"tooltip-format": "Power profile: {profile}"
	},
	
	"idle_inhibitor": {
	  "format": "{icon}",
	  "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
	  "tooltip": false
	},
	
	"custom/nightlight": {
	  "exec": "pgrep -x hyprsunset >/dev/null && echo '{\"alt\":\"on\",\"class\":\"on\"}' || echo '{\"alt\":\"off\",\"class\":\"off\"}'",
	  "return-type": "json",
	  "format": "{icon}",
	  "format-icons": { "on": "", "off": "" },
	  "interval": 10,
	  "signal": 9,
	  "on-click": "pkill -x hyprsunset || setsid -f hyprsunset -t 4000; sleep 0.2; pkill -RTMIN+9 waybar",
	  	  "tooltip": false
	},
	
	"custom/kbd": {
	  "exec": "echo 0 || brightnessctl -d <kbd-device> get",
	  "format": "󰌌 {}",
	  "interval": 10,
	  "signal": 8,
	  "on-click": "d=<kbd-device>; c=$(brightnessctl -d $d get); m=$(brightnessctl -d $d max); brightnessctl -q -d $d set $(( c >= m ? 0 : c + 1 )); pkill -RTMIN+8 waybar",
	  	  "tooltip": false
	},
		    
    "clock": {
        "tooltip-format": "<big>{:%d. %B %Y}</big>"
    },

    "bluetooth": {
    	"format": "󰂯",
    	"format-connected": "󰂯 {device-alias}",
    	"on-click": "pkill -x bluetui || kitty --class tui-popup -e bluetui",
    	"on-click-right": "rfkill toggle bluetooth"
    },

    "tray": {
    	"icon-size": 16,
    	"spacing": 4
    },

    "mpris": {
    	"format": "\uf04b {artist} - {title}",
    	"max-length": 20,
    	"on-click": "playerctl play-pause",
    	"tooltip-format": "{artist} - {title}"
    },

    "battery": {
    	"states": { "warning": 30, "critical": 15 },
    	"format": "{icon} {capacity}",
    	"format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    	"format-charging": "󰂄 {capacity}",
    	"format-plugged": "󰂄 {capacity}"    	
    },

    "wireplumber": {
    	"format": "{icon}",
    	"format-icons": ["", "", ""],
    	"format-muted": "",
    	"tooltip-format": "{node_name}: {volume}",
    	"on-click": "pkill -x wiremix || kitty --class tui-popup -e wiremix --tab output",
    	"on-click-right": "swayosd-client --output-volume mute-toggle"  	
    },

    "custom/notifications": {
    	"exec": "swaync-client -swb",
    	"return-type": "json",
    	"escape": true,
    	"tooltip": false,
    	"format": "{icon}",
    	"format-icons": {
    		"notification": "",
			"none": "",
			"dnd-notification": "",
			"dnd-none": "",
			"inhibited-notification": "",
			"dnd-inhibited-notification": "",
			"dnd-inhibited-none": ""    		
    	},
    	"on-click": "swaync-client -t -sw",
    	"on-click-right": "swaync-client -d -sw"
    }
}
