/* Rofi colors, generated by matugen. Names use hyphens: Rasi does not allow underscores.
 * Template: ~/.config/matugen/templates/rofi-colors.rasi
 * Output:   ~/.config/rofi/themes/colors.rasi  (do not edit the output by hand) */

* {
  /* ---------- Scheme roles ---------- */
  background:                 #16111b;
  on-background:              #e9dfee;

  surface:                    #16111b;
  surface-dim:                #16111b;
  surface-bright:             #3d3742;

  surface-container-lowest:   #110c16;
  surface-container-low:      #1e1a24;
  surface-container:          #221e28;
  surface-container-high:     #2d2833;
  surface-container-highest:  #38333e;

  on-surface:                 #e9dfee;
  surface-variant:            #4a4450;
  on-surface-variant:         #cdc3d1;

  inverse-surface:            #e9dfee;
  inverse-on-surface:         #342e39;

  outline:                    #968e9b;
  outline-variant:            #4a4450;
  shadow:                     #000000;
  scrim:                      #000000;
  surface-tint:               #d9b9ff;

  primary:                    #d9b9ff;
  on-primary:                 #460085;
  primary-container:          #6300ba;
  on-primary-container:       #eedcff;
  inverse-primary:            #8300f2;

  primary-fixed:              #eedcff;
  primary-fixed-dim:          #d9b9ff;
  on-primary-fixed:           #2a0054;
  on-primary-fixed-variant:   #6300ba;

  secondary:                  #dabde2;
  on-secondary:               #3d2946;
  secondary-container:        #553f5d;
  on-secondary-container:     #f7d8ff;

  secondary-fixed:            #f7d8ff;
  secondary-fixed-dim:        #dabde2;
  on-secondary-fixed:         #271430;
  on-secondary-fixed-variant: #553f5d;

  tertiary:                   #ebb6e4;
  on-tertiary:                #482247;
  tertiary-container:         #61395f;
  on-tertiary-container:      #ffd6f8;

  tertiary-fixed:             #ffd6f8;
  tertiary-fixed-dim:         #ebb6e4;
  on-tertiary-fixed:          #300c31;
  on-tertiary-fixed-variant:  #61395f;

  error:                      #ffb4ab;
  on-error:                   #690005;
  error-container:            #93000a;
  on-error-container:         #ffdad6;

  source-color:               #6c5589;

  /* ---------- Tonal palettes: _NN = lightness 0..100 ---------- */
  /* primary */
  primary-0:           #000000;
  primary-5:           #1b003b;
  primary-10:          #2a0054;
  primary-15:          #350c62;
  primary-20:          #401b6d;
  primary-25:          #4c2879;
  primary-30:          #583485;
  primary-35:          #644092;
  primary-40:          #714d9f;
  primary-50:          #8b66ba;
  primary-60:          #a57fd6;
  primary-70:          #c19af3;
  primary-80:          #d9b9ff;
  primary-90:          #eedcff;
  primary-95:          #f8edff;
  primary-98:          #fff7ff;
  primary-99:          #fffbff;
  primary-100:         #ffffff;

  /* secondary */
  secondary-0:         #000000;
  secondary-5:         #150d1f;
  secondary-10:        #20182a;
  secondary-15:        #2a2235;
  secondary-20:        #352d40;
  secondary-25:        #41384b;
  secondary-30:        #4c4357;
  secondary-35:        #584e63;
  secondary-40:        #655a6f;
  secondary-50:        #7e7389;
  secondary-60:        #988ca3;
  secondary-70:        #b3a6be;
  secondary-80:        #cfc1da;
  secondary-90:        #ecddf7;
  secondary-95:        #f8edff;
  secondary-98:        #fff7ff;
  secondary-99:        #fffbff;
  secondary-100:       #ffffff;

  /* tertiary */
  tertiary-0:          #000000;
  tertiary-5:          #25060e;
  tertiary-10:         #321018;
  tertiary-15:         #3e1a22;
  tertiary-20:         #4b252d;
  tertiary-25:         #582f37;
  tertiary-30:         #653b43;
  tertiary-35:         #72464e;
  tertiary-40:         #80525a;
  tertiary-50:         #9b6a72;
  tertiary-60:         #b7838b;
  tertiary-70:         #d49da6;
  tertiary-80:         #f2b7c1;
  tertiary-90:         #ffd9de;
  tertiary-95:         #ffecee;
  tertiary-98:         #fff8f7;
  tertiary-99:         #fffbff;
  tertiary-100:        #ffffff;

  /* error */
  error-0:             #000000;
  error-5:             #2d0001;
  error-10:            #410002;
  error-15:            #540003;
  error-20:            #690005;
  error-25:            #7e0007;
  error-30:            #93000a;
  error-35:            #a80710;
  error-40:            #ba1a1a;
  error-50:            #de3730;
  error-60:            #ff5449;
  error-70:            #ff897d;
  error-80:            #ffb4ab;
  error-90:            #ffdad6;
  error-95:            #ffedea;
  error-98:            #fff8f7;
  error-99:            #fffbff;
  error-100:           #ffffff;

  /* neutral */
  neutral-0:           #000000;
  neutral-5:           #121014;
  neutral-10:          #1d1b1e;
  neutral-15:          #272528;
  neutral-20:          #322f33;
  neutral-25:          #3d3a3e;
  neutral-30:          #49464a;
  neutral-35:          #555155;
  neutral-40:          #615d61;
  neutral-50:          #7a767a;
  neutral-60:          #948f94;
  neutral-70:          #afaaae;
  neutral-80:          #cac5c9;
  neutral-90:          #e7e1e5;
  neutral-95:          #f5eff4;
  neutral-98:          #fef7fc;
  neutral-99:          #fffbff;
  neutral-100:         #ffffff;

  /* neutral_variant */
  neutral-variant-0:   #000000;
  neutral-variant-5:   #130f17;
  neutral-variant-10:  #1e1a22;
  neutral-variant-15:  #28242c;
  neutral-variant-20:  #332f37;
  neutral-variant-25:  #3e3a42;
  neutral-variant-30:  #4a454e;
  neutral-variant-35:  #56505a;
  neutral-variant-40:  #625c66;
  neutral-variant-50:  #7b757f;
  neutral-variant-60:  #958e99;
  neutral-variant-70:  #b0a9b3;
  neutral-variant-80:  #ccc4cf;
  neutral-variant-90:  #e8e0eb;
  neutral-variant-95:  #f7eef9;
  neutral-variant-98:  #fff7ff;
  neutral-variant-99:  #fffbff;
  neutral-variant-100: #ffffff;
  /* ---------- Extras ---------- */
  window-bg: rgba(42, 34, 53, 0.85);
}
