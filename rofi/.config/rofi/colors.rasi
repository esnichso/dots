/* Rofi colors, generated by matugen. Names use hyphens: Rasi does not allow underscores.
 * Template: ~/.config/matugen/templates/rofi-colors.rasi
 * Output:   ~/.config/rofi/themes/colors.rasi  (do not edit the output by hand) */

* {
  /* ---------- Scheme roles ---------- */
  background:                 #091518;
  on-background:              #d8e5e9;

  surface:                    #091518;
  surface-dim:                #091518;
  surface-bright:             #2f3b3f;

  surface-container-lowest:   #051013;
  surface-container-low:      #121d21;
  surface-container:          #162125;
  surface-container-high:     #202c2f;
  surface-container-highest:  #2b373a;

  on-surface:                 #d8e5e9;
  surface-variant:            #3d494c;
  on-surface-variant:         #bcc9cd;

  inverse-surface:            #d8e5e9;
  inverse-on-surface:         #273236;

  outline:                    #869397;
  outline-variant:            #3d494c;
  shadow:                     #000000;
  scrim:                      #000000;
  surface-tint:               #00d9fc;

  primary:                    #00d9fc;
  on-primary:                 #003640;
  primary-container:          #004e5c;
  on-primary-container:       #abedff;
  inverse-primary:            #006879;

  primary-fixed:              #abedff;
  primary-fixed-dim:          #00d9fc;
  on-primary-fixed:           #001f26;
  on-primary-fixed-variant:   #004e5c;

  secondary:                  #a8cbe2;
  on-secondary:               #0d3446;
  secondary-container:        #284b5d;
  on-secondary-container:     #c4e7ff;

  secondary-fixed:            #c4e7ff;
  secondary-fixed-dim:        #a8cbe2;
  on-secondary-fixed:         #001e2c;
  on-secondary-fixed-variant: #284b5d;

  tertiary:                   #a4caf5;
  on-tertiary:                #003256;
  tertiary-container:         #21496e;
  on-tertiary-container:      #d0e4ff;

  tertiary-fixed:             #d0e4ff;
  tertiary-fixed-dim:         #a4caf5;
  on-tertiary-fixed:          #001d34;
  on-tertiary-fixed-variant:  #21496e;

  error:                      #ffb4ab;
  on-error:                   #690005;
  error-container:            #93000a;
  on-error-container:         #ffdad6;

  source-color:               #0a242a;

  /* ---------- Tonal palettes: _NN = lightness 0..100 ---------- */
  /* primary */
  primary-0:           #000000;
  primary-5:           #001419;
  primary-10:          #001f26;
  primary-15:          #002a33;
  primary-20:          #003640;
  primary-25:          #00424e;
  primary-30:          #004e5c;
  primary-35:          #005b6a;
  primary-40:          #006879;
  primary-50:          #008398;
  primary-60:          #009fb8;
  primary-70:          #2cbad7;
  primary-80:          #55d6f3;
  primary-90:          #abedff;
  primary-95:          #d8f6ff;
  primary-98:          #f0fbff;
  primary-99:          #f8fdff;
  primary-100:         #ffffff;

  /* secondary */
  secondary-0:         #000000;
  secondary-5:         #001419;
  secondary-10:        #061f24;
  secondary-15:        #11292f;
  secondary-20:        #1d343a;
  secondary-25:        #283f45;
  secondary-30:        #334a51;
  secondary-35:        #3f565c;
  secondary-40:        #4b6269;
  secondary-50:        #637b82;
  secondary-60:        #7d959c;
  secondary-70:        #97afb7;
  secondary-80:        #b2cbd2;
  secondary-90:        #cee7ee;
  secondary-95:        #dcf5fd;
  secondary-98:        #f0fbff;
  secondary-99:        #f8fdff;
  secondary-100:       #ffffff;

  /* tertiary */
  tertiary-0:          #000000;
  tertiary-5:          #070e2c;
  tertiary-10:         #131a37;
  tertiary-15:         #1d2442;
  tertiary-20:         #282f4d;
  tertiary-25:         #333a59;
  tertiary-30:         #3e4565;
  tertiary-35:         #4a5171;
  tertiary-40:         #565d7e;
  tertiary-50:         #6f7598;
  tertiary-60:         #898fb3;
  tertiary-70:         #a3a9ce;
  tertiary-80:         #bec4eb;
  tertiary-90:         #dde1ff;
  tertiary-95:         #f0efff;
  tertiary-98:         #fbf8ff;
  tertiary-99:         #fefbff;
  tertiary-100:        #ffffff;

  /* error */
  error-0:             #000000;
  error-5:             #2d0001;
  error-10:            #410002;
  error-15:            #540003;
  error-20:            #690005;
  error-25:            #7e0007;
  error-30:            #93000a;
  error-35:            #a80710;
  error-40:            #ba1a1a;
  error-50:            #de3730;
  error-60:            #ff5449;
  error-70:            #ff897d;
  error-80:            #ffb4ab;
  error-90:            #ffdad6;
  error-95:            #ffedea;
  error-98:            #fff8f7;
  error-99:            #fffbff;
  error-100:           #ffffff;

  /* neutral */
  neutral-0:           #000000;
  neutral-5:           #0e1112;
  neutral-10:          #191c1d;
  neutral-15:          #232627;
  neutral-20:          #2e3132;
  neutral-25:          #393c3d;
  neutral-30:          #444748;
  neutral-35:          #505354;
  neutral-40:          #5c5f60;
  neutral-50:          #757779;
  neutral-60:          #8e9192;
  neutral-70:          #a9abad;
  neutral-80:          #c4c7c8;
  neutral-90:          #e1e3e4;
  neutral-95:          #eff1f2;
  neutral-98:          #f8fafb;
  neutral-99:          #fbfcfd;
  neutral-100:         #ffffff;

  /* neutral_variant */
  neutral-variant-0:   #000000;
  neutral-variant-5:   #0a1215;
  neutral-variant-10:  #141d1f;
  neutral-variant-15:  #1f272a;
  neutral-variant-20:  #293234;
  neutral-variant-25:  #343d3f;
  neutral-variant-30:  #3f484b;
  neutral-variant-35:  #4b5457;
  neutral-variant-40:  #576063;
  neutral-variant-50:  #70797b;
  neutral-variant-60:  #899295;
  neutral-variant-70:  #a4adb0;
  neutral-variant-80:  #bfc8cb;
  neutral-variant-90:  #dbe4e7;
  neutral-variant-95:  #e9f2f5;
  neutral-variant-98:  #f2fbfe;
  neutral-variant-99:  #f8fdff;
  neutral-variant-100: #ffffff;
  /* ---------- Extras ---------- */
  window-bg: rgba(17, 41, 47, 0.85);
}
