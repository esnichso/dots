/* Rofi colors, generated by matugen. Names use hyphens: Rasi does not allow underscores.
 * Template: ~/.config/matugen/templates/rofi-colors.rasi
 * Output:   ~/.config/rofi/themes/colors.rasi  (do not edit the output by hand) */

* {
  /* ---------- Scheme roles ---------- */
  background:                 #0c141b;
  on-background:              #dbe4ed;

  surface:                    #0c141b;
  surface-dim:                #0c141b;
  surface-bright:             #313a41;

  surface-container-lowest:   #070f15;
  surface-container-low:      #141d23;
  surface-container:          #182127;
  surface-container-high:     #222b32;
  surface-container-highest:  #2d363d;

  on-surface:                 #dbe4ed;
  surface-variant:            #3f484f;
  on-surface-variant:         #bfc8d0;

  inverse-surface:            #dbe4ed;
  inverse-on-surface:         #293138;

  outline:                    #89929a;
  outline-variant:            #3f484f;
  shadow:                     #000000;
  scrim:                      #000000;
  surface-tint:               #87ceff;

  primary:                    #87ceff;
  on-primary:                 #00344d;
  primary-container:          #004c6d;
  on-primary-container:       #c8e6ff;
  inverse-primary:            #006590;

  primary-fixed:              #c8e6ff;
  primary-fixed-dim:          #87ceff;
  on-primary-fixed:           #001e2e;
  on-primary-fixed-variant:   #004c6d;

  secondary:                  #b3c8e9;
  on-secondary:               #1d314b;
  secondary-container:        #344863;
  on-secondary-container:     #d3e3ff;

  secondary-fixed:            #d3e3ff;
  secondary-fixed-dim:        #b3c8e9;
  on-secondary-fixed:         #051c35;
  on-secondary-fixed-variant: #344863;

  tertiary:                   #b8c4fa;
  on-tertiary:                #212e5a;
  tertiary-container:         #384472;
  on-tertiary-container:      #dce1ff;

  tertiary-fixed:             #dce1ff;
  tertiary-fixed-dim:         #b8c4fa;
  on-tertiary-fixed:          #0a1844;
  on-tertiary-fixed-variant:  #384472;

  error:                      #ffb4ab;
  on-error:                   #690005;
  error-container:            #93000a;
  on-error-container:         #ffdad6;

  source-color:               #0a2839;

  /* ---------- Tonal palettes: _NN = lightness 0..100 ---------- */
  /* primary */
  primary-0:           #000000;
  primary-5:           #00131f;
  primary-10:          #001e2e;
  primary-15:          #00293d;
  primary-20:          #00344d;
  primary-25:          #00405d;
  primary-30:          #004c6d;
  primary-35:          #00587e;
  primary-40:          #006590;
  primary-50:          #007fb4;
  primary-60:          #3299d1;
  primary-70:          #55b4ed;
  primary-80:          #87ceff;
  primary-90:          #c8e6ff;
  primary-95:          #e5f2ff;
  primary-98:          #f6faff;
  primary-99:          #fbfcff;
  primary-100:         #ffffff;

  /* secondary */
  secondary-0:         #000000;
  secondary-5:         #02131e;
  secondary-10:        #0b1d29;
  secondary-15:        #162833;
  secondary-20:        #21323e;
  secondary-25:        #2c3d4a;
  secondary-30:        #384956;
  secondary-35:        #435562;
  secondary-40:        #4f606e;
  secondary-50:        #687987;
  secondary-60:        #8193a2;
  secondary-70:        #9badbd;
  secondary-80:        #b7c9d8;
  secondary-90:        #d2e5f5;
  secondary-95:        #e5f2ff;
  secondary-98:        #f6faff;
  secondary-99:        #fbfcff;
  secondary-100:       #ffffff;

  /* tertiary */
  tertiary-0:          #000000;
  tertiary-5:          #140b2a;
  tertiary-10:         #1f1635;
  tertiary-15:         #292140;
  tertiary-20:         #342b4b;
  tertiary-25:         #403657;
  tertiary-30:         #4b4163;
  tertiary-35:         #574d6f;
  tertiary-40:         #63597c;
  tertiary-50:         #7c7196;
  tertiary-60:         #978bb1;
  tertiary-70:         #b2a5cc;
  tertiary-80:         #cdc0e9;
  tertiary-90:         #e9ddff;
  tertiary-95:         #f6edff;
  tertiary-98:         #fef7ff;
  tertiary-99:         #fffbff;
  tertiary-100:        #ffffff;

  /* error */
  error-0:             #000000;
  error-5:             #2d0001;
  error-10:            #410002;
  error-15:            #540003;
  error-20:            #690005;
  error-25:            #7e0007;
  error-30:            #93000a;
  error-35:            #a80710;
  error-40:            #ba1a1a;
  error-50:            #de3730;
  error-60:            #ff5449;
  error-70:            #ff897d;
  error-80:            #ffb4ab;
  error-90:            #ffdad6;
  error-95:            #ffedea;
  error-98:            #fff8f7;
  error-99:            #fffbff;
  error-100:           #ffffff;

  /* neutral */
  neutral-0:           #000000;
  neutral-5:           #0f1113;
  neutral-10:          #191c1e;
  neutral-15:          #242628;
  neutral-20:          #2e3133;
  neutral-25:          #393c3e;
  neutral-30:          #454749;
  neutral-35:          #515355;
  neutral-40:          #5d5e61;
  neutral-50:          #75777a;
  neutral-60:          #8f9193;
  neutral-70:          #aaabae;
  neutral-80:          #c5c6c9;
  neutral-90:          #e2e2e5;
  neutral-95:          #f0f0f3;
  neutral-98:          #f9f9fc;
  neutral-99:          #fcfcff;
  neutral-100:         #ffffff;

  /* neutral_variant */
  neutral-variant-0:   #000000;
  neutral-variant-5:   #0b1216;
  neutral-variant-10:  #161c21;
  neutral-variant-15:  #20272c;
  neutral-variant-20:  #2b3136;
  neutral-variant-25:  #363c42;
  neutral-variant-30:  #41484d;
  neutral-variant-35:  #4d5359;
  neutral-variant-40:  #595f65;
  neutral-variant-50:  #71787e;
  neutral-variant-60:  #8b9198;
  neutral-variant-70:  #a6acb2;
  neutral-variant-80:  #c1c7ce;
  neutral-variant-90:  #dde3ea;
  neutral-variant-95:  #ebf1f8;
  neutral-variant-98:  #f6faff;
  neutral-variant-99:  #fbfcff;
  neutral-variant-100: #ffffff;
  /* ---------- Extras ---------- */
  window-bg: rgba(22, 40, 51, 0.85);
}
