@import "colors.rasi"

* {
	font: "JetsBrainMono Nerd Font 12";
	background-color: transparent;
	text-color: @on-surface;
	margin: 0;
	padding: 0;
	spacing: 0;
}

window {
	location: center;
	anchor: center;
	width: 400px;
	background-color: @window-bg;
	border-radius: 12px;
	padding: 12px;
}

mainbox {
	spacing: 10px;
	children: [inputbar, listview];
}

inputbar {
	background-color: @secondary-25;
	border-radius: 999px;
	padding: 8px 14px;
	spacing: 8px;
	children: [prompt, entry];
}

prompt {
	text-color: @on-surface;
}

entry {
	placeholder: "Search...";
	placeholder-color: @on-surface-variant;
}


listview {
	lines: 8;
	columns: 1;
	fixed-height: true;
	scrollbar: false;
	spacing: 4px;
}
element {
	padding: 6px 10px;
	spacing: 10px;
	border-radius: 8px;
}

element selected.normal {
	background-color: @primary-container;
	text-color: @on-primary-container;
}
element-icon {
	size: 24px;
	background-color: inherit;
}
element-text {
	background-color: inherit;
	text-color: inherit;
	vertical-align: 0.5;
}
button {
	padding: 4px 10px;
	border-radius: 999px;
	background-color: @secondary-25;
	text-color: @on-surface-variant;
}
button selected {
	background-color: @primary-container;
	text-color: @on-primary-container;
}
